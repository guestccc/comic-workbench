diff --git a/uploader/xiaohongshu_uploader/main.py b/uploader/xiaohongshu_uploader/main.py
index 4db1542..2f9ff44 100644
--- a/uploader/xiaohongshu_uploader/main.py
+++ b/uploader/xiaohongshu_uploader/main.py
@@ -577,6 +577,57 @@ class XiaoHongShuBaseUploader(BaseVideoUploader):
             xiaohongshu_logger.error(_msg("🧾", f"内容声明「{declaration}」设置失败: {exc}"))
             raise RuntimeError(f"内容声明「{declaration}」设置失败，拒绝继续发布: {exc}") from exc
 
+    async def apply_collection(self, page: Page) -> None:
+        """选择已存在的小红书合集。
+
+        发布页「选择合集」弹出 ``.collection-plugin-popover``，条目为
+        ``.item > .item-content > .item-label``。合集名找不到时跳过并告警，
+        不阻断发布（与抖音一致，合集属于可选增强项）。
+        """
+        collection = getattr(self, "collection_name", None)
+        if not collection:
+            return
+        try:
+            trigger = page.get_by_text("选择合集", exact=True).first
+            if not await trigger.count():
+                xiaohongshu_logger.warning(_msg("📚", "未找到「选择合集」入口，跳过合集"))
+                return
+            try:
+                await trigger.scroll_into_view_if_needed(timeout=5000)
+            except Exception:
+                pass
+            try:
+                await trigger.click(timeout=8000)
+            except Exception:
+                await _js_click_by_text(page, "选择合集")
+            await page.wait_for_timeout(1000)
+
+            popover = page.locator(".d-popover.collection-plugin-popover").first
+            await popover.wait_for(state="visible", timeout=8000)
+            item = popover.get_by_text(collection, exact=True).first
+            if not await item.count():
+                xiaohongshu_logger.warning(
+                    _msg("📚", f"合集列表未找到「{collection}」，跳过合集，保持未选状态")
+                )
+                await page.keyboard.press("Escape")
+                await page.wait_for_timeout(300)
+                return
+            try:
+                await item.click(timeout=6000)
+            except Exception:
+                await item.click(force=True, timeout=6000)
+            await page.wait_for_timeout(800)
+            # 选中后入口文案变为合集名，「选择合集」消失
+            if await page.get_by_text("选择合集", exact=True).count():
+                raise RuntimeError(f"合集「{collection}」未生效")
+            xiaohongshu_logger.success(_msg("📚", f"已选择合集：{collection}"))
+        except Exception as exc:
+            xiaohongshu_logger.warning(_msg("📚", f"选择合集失败，跳过合集继续发布: {exc}"))
+            try:
+                await page.keyboard.press("Escape")
+            except Exception:
+                pass
+
 
